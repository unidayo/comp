from collections.abc import Callable
from typing import Any, TypeVar, overload

_F = TypeVar("_F", bound=Callable[..., Any])

PARAMETER_DOCS: dict[str, str]
defaults: dict[str, int]

@overload
def set_param(options: str, /) -> None: ...
@overload
def set_param(**options: int) -> None: ...

def dont_trace_here(function: _F, /) -> _F: ...
def mark_as_being_traced(function: _F, /) -> _F: ...
def not_from_assembler(function: _F, /) -> _F: ...
def releaseall() -> None: ...
def residual_call(function: Callable[..., Any], *args: Any, **kwargs: Any) -> Any: ...
def set_abort_hook(hook: Callable[..., Any] | None, /) -> None: ...
def set_compile_hook(
    hook: Callable[..., Any] | None,
    operations: bool = True,
    /,
) -> None: ...
def set_trace_too_long_hook(hook: Callable[..., Any] | None, /) -> None: ...
def trace_next_iteration(*args: Any, **kwargs: Any) -> Any: ...
def trace_next_iteration_hash(*args: Any, **kwargs: Any) -> Any: ...

{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ Debug (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/${fileBasenameNoExtension}",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "terminal": "integrated",
            "preRunCommands": [
                "breakpoint set --name main"
            ],
            "preLaunchTask": "C++: build debug link"
        },
        {
            "name": "C++ Debug (lldb, input.txt)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/${fileBasenameNoExtension}",
            "args": [],
            "stopOnEntry": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "ASAN_OPTIONS": "detect_leaks=0"
            },
            "terminal": "integrated",
            "preRunCommands": [
                "breakpoint set --name main"
            ],
            "stdio": [
                "${workspaceFolder}/input.txt",
                null,
                null
            ],
            "preLaunchTask": "C++: build debug link"
        },
        {
            "name": "C++ Debug (gdb)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build-debug/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],

            "externalConsole": false,
            "internalConsoleOptions": "neverOpen",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "filterStderr": true,
            "preLaunchTask": "C++: build debug link",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at main",
                    "text": "-break-insert main",
                    "ignoreFailures": false
                }
            ]
        },
        {
            "name": "C++ Debug (gdb, input.txt)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/build-debug/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,

            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],

            "externalConsole": false,
            "internalConsoleOptions": "neverOpen",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "filterStderr": true,
            "preLaunchTask": "C++: build debug link",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Break at main",
                    "text": "-break-insert main",
                    "ignoreFailures": false
                },
                {
                    "description": "Use input.txt as stdin",
                    "text": "-interpreter-exec console \"set args < ${workspaceFolder}/input.txt\"",
                    "ignoreFailures": false
                }
            ]
        }
    ]
}

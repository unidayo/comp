			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
		{
			"label": "Contest: new Codeforces problem",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_cf_problem.sh",

{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake-configure-debug",
			"type": "shell",
			"command": "cmake -S . -B build-debug -G Ninja -DCMAKE_BUILD_TYPE=Debug",
		},
		{
			"label": "cmake-configure-release",
			"type": "shell",
			"command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release",
		},
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/",
				"--target",
				"${fileBasenameNoExtension}",
			],
			"dependsOn": [
				"cmake-configure-release"
			],
		},
		{
			"label": "build-debug-O0",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/",
				"--target",
				"${fileBasenameNoExtension}",
			],
			"dependsOn": [
				"cmake-configure-debug"
			],
		},
		{
			"label": "new contest",
			"type": "shell",
			"command": "${workspaceFolder}/cmd/new_contest.sh ${input:cid}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
		{
			"label": "execute",
			"type": "shell",
			"command": "build/${fileBasenameNoExtension}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "execute with input.txt",
			"type": "shell",
			"command": "build/${fileBasenameNoExtension}<${workspaceFolder}/input.txt",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "test sample",
			"type": "shell",
			"command": "cd ${fileDirname} && /home/wsl2ubuntu/comp/.venv/bin/oj t -c ${workspaceFolder}/build/${fileBasenameNoExtension}",
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "submit",
			"type": "shell",
			"command": "cd ${fileDirname} && acc submit -s -- -w 0",
		},
	],
	"inputs": [
		{
			"id": "cid",
			"description": "ダウンロードするコンテスト名を入力してください",
			"type": "promptString"
		},
	]
}
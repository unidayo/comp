{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build/",
				"--target",
				"${fileBasenameNoExtension}"
			]
		},
		{
			"label": "new contest",
			"type": "shell",
			"command": "${workspaceFolder}/cmd/new_contest.bash ${input:cid}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
		{
			"label": "execute",
			"type": "shell",
			"command": "build/${fileBasenameNoExtension}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "execute with input.txt",
			"type": "shell",
			"command": "build/${fileBasenameNoExtension}<${workspaceFolder}/input.txt",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "test sample",
			"type": "shell",
			"command": "cd ${fileDirname} && oj t -c ${workspaceFolder}/build/${fileBasenameNoExtension}",
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "submit",
			"type": "shell",
			"command": "cd ${fileDirname} && acc submit -s -- -w 1",
		},
	],
	"inputs": [
		{
			"id": "cid",
			"description": "ダウンロードするコンテスト名を入力してください",
			"type": "promptString"
		},
	]
}
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "cmake-configure-debug",
			"type": "shell",
			"command": "cmake -S . -B build-debug -G Ninja -DCMAKE_BUILD_TYPE=Debug",
		},
		{
			"label": "cmake-configure-release",
			"type": "shell",
			"command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release",
		},
		{
			"label": "build",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build-release/",
				"--target",
				"${fileBasenameNoExtension}",
			],
			"dependsOn": [
				"cmake-configure-release"
			],
		},
		{
			"label": "build-debug-O0",
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build",
				"build-debug/",
				"--target",
				"${fileBasenameNoExtension}",
			],
			"dependsOn": [
				"cmake-configure-debug"
			],
		},
		{
			"label": "new contest",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_contest.sh",
				"${input:contest}"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
		{
			"label": "new problem",
			"type": "shell",
			"command": "bash",
			"args": [
				"/home/wsl2ubuntu/comp/scripts/new_problem.sh",
				"${input:contest}",
			],
			"problemMatcher": []
		},
		{
			"label": "execute",
			"type": "shell",
			"command": "build-release/${fileBasenameNoExtension}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "execute with input.txt",
			"type": "shell",
			"command": "build-release/${fileBasenameNoExtension}<${workspaceFolder}/input.txt",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "test sample",
			"type": "shell",
			"command": "cd ${fileDirname} && /home/wsl2ubuntu/comp/.venv/bin/oj t -c ${workspaceFolder}/build-release/${fileBasenameNoExtension}",
			"dependsOn": [
				"build"
			],
		},
		{
			"label": "submit",
			"type": "shell",
			"command": "cd ${fileDirname} && acc submit -s -- -w 0",
		},
	],
	"inputs": [
		{
			"id": "contest",
			"type": "promptString",
			"description": "contest id (e.g. abc347)"
		},
		{
			"id": "task",
			"type": "promptString",
			"description": "task id (e.g. a)"
		}
	]
}
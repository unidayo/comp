{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "C++: configure debug",
			"type": "shell",
			"command": "cmake -S . -B build-debug -G Ninja -DCMAKE_BUILD_TYPE=Debug",
			"detail": "Configure build-debug without changing the active source filter.",
		},
		{
			"label": "C++: configure release",
			"type": "shell",
			"command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release",
			"detail": "Configure build-release without changing the active source filter.",
		},
		{
			"label": "C++: build debug",
			"type": "shell",
			"command": "cmake -S . -B build-debug -G Ninja -DCMAKE_BUILD_TYPE=Debug -DENABLE_SANITIZERS=ON -DCOMP_ACTIVE_SOURCE='${file}' && cmake --build build-debug/ --target $(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension} -j",
			"detail": "Build the active C++ file with -O0, sanitizers, and _GLIBCXX_DEBUG.",
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "C++: build fast",
			"type": "shell",
			"command": "\"${workspaceFolder}/scripts/build_fast_cpp.sh\" \"${file}\"",
			"detail": "Build the active C++ file directly with a reusable PCH, _GLIBCXX_DEBUG, ASan, and UBSan.",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": []
		},
		{
			"label": "C++: build release",
			"type": "shell",
			"command": "cmake -S . -B build-release -G Ninja -DCMAKE_BUILD_TYPE=Release -DENABLE_SANITIZERS=ON -DCOMP_ACTIVE_SOURCE='${file}' && cmake --build build-release/ --target $(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension} -j",
			"detail": "Build the active C++ file with -O2 and sanitizers.",
			"problemMatcher": []
		},
		{
			"label": "C++: build debug link",
			"type": "shell",
			"command": "\"${workspaceFolder}/scripts/build_debug_cpp.sh\" \"${file}\"",
			"detail": "Build the active C++ file directly for lldb/gdb and create build-debug/<filename> symlink.",
			"presentation": {
				"reveal": "silent",
				"focus": false,
				"panel": "dedicated",
				"clear": true
			},
			"problemMatcher": []
		},
		{
			"label": "Contest: new AtCoder contest",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_contest.sh",
				"${input:contest}"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
		{
			"label": "Contest: new Codeforces contest",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_cf_contest.sh",

		{
			"label": "Archive: contests",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/archive_contests.sh"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []

		{
			"label": "Problem: new Python standalone",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_standalone_python_problem.sh"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []

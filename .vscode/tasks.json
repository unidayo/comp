		{
			"label": "Problem: new C++ standalone",
			"type": "shell",
			"command": "bash",
			"args": [
				"${workspaceFolder}/scripts/new_standalone_problem.sh"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []

		{
			"label": "Python: execute",
			"type": "shell",
			"command": "${workspaceFolder}/.venv-pypy/bin/python",
			"args": [
				"${file}"
			],
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []
		},
		{
			"label": "Python: execute input.txt",
			"type": "shell",
			"command": "\"${workspaceFolder}/.venv-pypy/bin/python\" \"${file}\" < \"${workspaceFolder}/input.txt\"",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []
		},
		{
			"label": "Python: test sample",
			"type": "shell",
			"command": "cd \"${fileDirname}\" && \"${workspaceFolder}/.venv/bin/oj\" t -c '\"${workspaceFolder}/.venv-pypy/bin/python\" \"${file}\"'",
			"group": "test",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []
		},
		{
			"label": "C++: execute",
			"type": "shell",
			"command": "ASAN_OPTIONS=detect_leaks=0 build-debug/$(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension}",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"C++: build debug"
			],
		},
		{
			"label": "C++: execute fast",
			"type": "shell",
			"command": "bin=\"$(\"${workspaceFolder}/scripts/build_fast_cpp.sh\" \"${file}\")\" && ASAN_OPTIONS=detect_leaks=0 \"$bin\"",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []
		},
		{
			"label": "C++: execute input.txt",
			"type": "shell",
			"command": "ASAN_OPTIONS=detect_leaks=0 build-debug/$(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension}<${workspaceFolder}/input.txt",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"dependsOn": [
				"C++: build debug"
			],
		},
		{
			"label": "C++: execute fast input.txt",
			"type": "shell",
			"command": "bin=\"$(\"${workspaceFolder}/scripts/build_fast_cpp.sh\" \"${file}\")\" && ASAN_OPTIONS=detect_leaks=0 \"$bin\" < \"${workspaceFolder}/input.txt\"",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
			"problemMatcher": []
		},
		{
			"label": "C++: test sample debug",
			"type": "shell",
			"command": "cd ${fileDirname} && ASAN_OPTIONS=detect_leaks=0 /home/wsl2ubuntu/comp/.venv/bin/oj t -c ${workspaceFolder}/build-debug/$(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension}",
			"group": "test",
			"detail": "Run oj sample tests with the -O0 sanitizer build.",
			"dependsOn": [
				"C++: build debug"
			],
		},
		{
			"label": "C++: test sample fast",
			"type": "shell",
			"command": "cd \"${fileDirname}\" && bin=\"$(\"${workspaceFolder}/scripts/build_fast_cpp.sh\" \"${file}\")\" && ASAN_OPTIONS=detect_leaks=0 \"${workspaceFolder}/.venv/bin/oj\" t -c \"$bin\"",
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"detail": "Run oj sample tests with the checked fast build.",
			"problemMatcher": []
		},
		{
			"label": "C++: test sample release",
			"type": "shell",
			"command": "cd ${fileDirname} && ASAN_OPTIONS=detect_leaks=0 /home/wsl2ubuntu/comp/.venv/bin/oj t -c ${workspaceFolder}/build-release/$(basename $(dirname '${fileDirname}'))_$(basename '${fileDirname}')_${fileBasenameNoExtension}",
			"group": "test",
			"detail": "Run oj sample tests with the -O2 sanitizer build.",
			"dependsOn": [
				"C++: build release"
			],
		},
		{
			"label": "Submit: AtCoder",
			"type": "shell",
			"command": "cd ${fileDirname} && acc submit -s -- -w 0",
		},
		{
			"label": "Codeforces: expand ACL",
			"type": "shell",
			"command": "python3 /usr/lib/ac-library/expander.py --lib /usr/lib/ac-library ${file} && sed -i '/#include <ankerl\\/unordered_dense.h>/d' ${fileDirname}/combined.cpp && sed -i '1s/^/#define ATCODER\\n/' ${fileDirname}/combined.cpp && echo 'Generated: ${fileDirname}/combined.cpp'",
			"presentation": {
				"reveal": "always",
				"focus": true,
				"panel": "shared",
			},
		},
	],
	"inputs": [
		{
			"id": "contest",
			"type": "promptString",
			"description": "contest id (e.g. abc347)"
		},
		{
			"id": "task",
			"type": "promptString",
			"description": "task id (e.g. a)"
		},
		{
			"id": "cf_contest_id",
			"type": "promptString",
			"description": "Codeforces contest ID (e.g. 2080)"
		},
		{
			"id": "cf_num_problems",
			"type": "promptString",
			"description": "number of problems (e.g. 6)"
		},
		{
			"id": "cf_problem_label",
			"type": "promptString",
			"description": "problem label (e.g. c)"
		},
	]

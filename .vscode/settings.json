{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv-pypy/bin/python",
    "python.analysis.extraPaths": [
        "${workspaceFolder}/.venv-pypy/lib/pypy3.11/site-packages"
    ],
    "python.analysis.useLibraryCodeForTypes": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticSeverityOverrides": {
        "reportMissingModuleSource": "none"
    },
    "clangd.arguments": [
        "--background-index",
        "--compile-commands-dir=${workspaceFolder}/build-release",
        "--clang-tidy",
        "--enable-config",
        "--header-insertion=never"
    ],
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.path": "/usr/bin/clangd-20",
    "C_Cpp.default.cppStandard": "c++23",
    "editor.formatOnPaste": true,
    "C_Cpp.default.includePath": [
        "/usr/lib/ac-library/**",
        "${workspaceFolder}/**"
    ],
    "cmake.configureOnOpen": false,
    "files.associations": {
        "numeric": "cpp",
        "tuple": "cpp",
        "iostream": "cpp",
        "initializer_list": "cpp",
        "valarray": "cpp",
        "charconv": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bitset": "cpp",
        "chrono": "cpp",
        "complex": "cpp",
        "condition_variable": "cpp",
        "cwchar": "cpp",
        "deque": "cpp",
        "forward_list": "cpp",
        "list": "cpp",
        "string": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "iterator": "cpp",
        "functional": "cpp",
        "fstream": "cpp",
        "future": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "mutex": "cpp",
        "new": "cpp",
        "ostream": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "utility": "cpp",
        "random": "cpp",
        "concepts": "cpp",
        "ranges": "cpp",
        "cmath": "cpp"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "clangd.checkUpdates": false,
    "clangd.onConfigChanged": "restart",
    "cmake.copyCompileCommands": "",
    "cmake.generator": "Ninja",
    "cmake.configureArgs": [],
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    }
}

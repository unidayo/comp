        "list": "cpp",
        "string": "cpp",
        "vector": "cpp",
        "exception": "cpp",
        "iterator": "cpp",
        "functional": "cpp",
        "fstream": "cpp",
        "future": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "mutex": "cpp",
        "new": "cpp",
        "ostream": "cpp",
        "sstream": "cpp",
        "stdexcept": "cpp",
        "streambuf": "cpp",
        "utility": "cpp",
        "random": "cpp",
        "concepts": "cpp",
        "ranges": "cpp",
        "cmath": "cpp"
    },
    "C_Cpp.errorSquiggles": "disabled",
    "clangd.checkUpdates": false,
    "clangd.onConfigChanged": "restart",
    "cmake.copyCompileCommands": "",
    "cmake.generator": "Ninja",
